# Application
EZTRIP_ENVIRONMENT=development
EZTRIP_LOG_LEVEL=INFO
EZTRIP_CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL
POSTGRES_DB=eztrip
POSTGRES_USER=eztrip
POSTGRES_PASSWORD=eztrip-local-only
POSTGRES_PORT=55432
EZTRIP_DATABASE_URL=postgresql+asyncpg://eztrip:eztrip-local-only@localhost:55432/eztrip

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Planning task API
# Fixture mode is the default. Live mode can spend API quota and must be opted into explicitly.
EZTRIP_PLANNING_LIVE_ENABLED=false
EZTRIP_PLANNING_CHECKPOINT_DIR=tmp/planning-task-checkpoints
EZTRIP_PLANNING_SSE_HEARTBEAT_SECONDS=15
EZTRIP_PLANNING_TASK_TIMEOUT_SECONDS=120

# LLM - DeepSeek OpenAI-compatible API
EZTRIP_LLM_PROVIDER=deepseek
EZTRIP_LLM_TIMEOUT_SECONDS=30
EZTRIP_LLM_MAX_RETRIES=1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Observability - LangSmith
# The live probe sends only a fixed synthetic request; CI never reads these values.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# Change to https://apac.api.smith.langchain.com if your LangSmith workspace is in APAC.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=eztrip-dev
# Only required when one API key can access multiple workspaces.
LANGSMITH_WORKSPACE_ID=

# Maps - AMap official MCP
# Keep the key separate from the URL so logs and traces can redact it safely.
AMAP_MAPS_API_KEY=
AMAP_MCP_URL=https://mcp.amap.com/mcp
AMAP_MCP_TRANSPORT=streamable_http
AMAP_MCP_TIMEOUT_SECONDS=20
AMAP_PROBE_TOTAL_TIMEOUT_SECONDS=90
# REST weather is only used when MCP omits freshness fields such as reporttime/adcode.
AMAP_REST_WEATHER_URL=https://restapi.amap.com/v3/weather/weatherInfo
# REST geocoding resolves arbitrary domestic destination names to canonical adcodes.
AMAP_REST_GEOCODE_URL=https://restapi.amap.com/v3/geocode/geo
