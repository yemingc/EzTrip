# Application
EZTRIP_ENVIRONMENT=development
EZTRIP_LOG_LEVEL=INFO
EZTRIP_CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL
POSTGRES_DB=eztrip
POSTGRES_USER=eztrip
POSTGRES_PASSWORD=eztrip-local-only
POSTGRES_PORT=55432
EZTRIP_DATABASE_URL=postgresql+asyncpg://eztrip:eztrip-local-only@localhost:55432/eztrip

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# LLM - DeepSeek OpenAI-compatible API
EZTRIP_LLM_PROVIDER=deepseek
EZTRIP_LLM_TIMEOUT_SECONDS=30
EZTRIP_LLM_MAX_RETRIES=1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Observability - LangSmith
# The live probe sends only a fixed synthetic request; CI never reads these values.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# Change to https://apac.api.smith.langchain.com if your LangSmith workspace is in APAC.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=eztrip-dev
# Only required when one API key can access multiple workspaces.
LANGSMITH_WORKSPACE_ID=

# Maps - AMap official MCP
# Keep the key separate from the URL so logs and traces can redact it safely.
AMAP_MAPS_API_KEY=
AMAP_MCP_URL=https://mcp.amap.com/mcp
AMAP_MCP_TRANSPORT=streamable_http
