  "fairness": {
    "same_structured_request": true,
    "same_provider_fixture": true,
    "same_output_trip_plan_contract": true,
    "same_post_run_evaluator": true,
    "same_model_name_for_live_run": true,
    "shared_case_eligibility_denominator": true,
    "development_regression_not_holdout": true
