      "scenario": "clean",
      "dimensions": {"city": "北京市", "trip_days": 3, "traveler_profile": "adults", "risk_dimensions": ["grounding"]},
      "expected": {"initial_error_codes": [], "full_outcome": "finalizable_without_repair", "final_can_finalize": true, "repair_actions": []},
      "boundary_notes": ["正常案例用于检查完整方案不会为了展示修复而强行进入循环。"]
    },
