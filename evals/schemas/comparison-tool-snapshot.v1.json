{
  "$defs": {
    "ActivityEnvironment": {
      "enum": [
        "indoor",
        "outdoor",
        "mixed",
        "unknown"
      ],
      "title": "ActivityEnvironment",
      "type": "string"
    },
    "BudgetAllocation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "allocator_version": {
          "const": "budget-allocator-v1",
          "default": "budget-allocator-v1",
          "title": "Allocator Version",
          "type": "string"
        },
        "policy_version": {
          "const": "cn-city-trip-weights-v1",
          "default": "cn-city-trip-weights-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Request Id",
          "type": "string"
        },
        "context_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Context Id",
          "type": "string"
        },
        "input_request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Request Sha256",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BudgetAllocationStatus"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetAllocationReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "total_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Limit"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        },
        "hard_limit": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hard Limit"
        },
        "included_categories": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BudgetCategory"
          },
          "title": "Included Categories",
          "type": "array"
        },
        "excluded_categories": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BudgetCategory"
          },
          "title": "Excluded Categories",
          "type": "array"
        },
        "allocations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BudgetAllocationItem"
          },
          "maxItems": 6,
          "title": "Allocations",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "context_id",
        "input_request_sha256",
        "status"
      ],
      "title": "BudgetAllocation",
      "type": "object"
    },
    "BudgetAllocationItem": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/BudgetCategory"
        },
        "policy_weight": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,2}|(?=[\\d.]{1,7}0*$)\\d{0,2}\\.\\d{0,4}0*$)",
              "type": "string"
            }
          ],
          "title": "Policy Weight"
        },
        "target_amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Target Amount"
        },
        "quantity_basis": {
          "$ref": "#/$defs/BudgetQuantityBasis"
        },
        "reference_quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,11}0*$)\\d{0,8}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Reference Quantity"
        },
        "target_per_unit": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Target Per Unit"
        }
      },
      "required": [
        "category",
        "policy_weight",
        "target_amount",
        "quantity_basis",
        "reference_quantity",
        "target_per_unit"
      ],
      "title": "BudgetAllocationItem",
      "type": "object"
    },
    "BudgetAllocationReason": {
      "enum": [
        "missing_budget",
        "missing_rooms"
      ],
      "title": "BudgetAllocationReason",
      "type": "string"
    },
    "BudgetAllocationStatus": {
      "enum": [
        "allocated",
        "blocked",
        "not_requested"
      ],
      "title": "BudgetAllocationStatus",
      "type": "string"
    },
    "BudgetCategory": {
      "enum": [
        "lodging",
        "transport",
        "food",
        "admission",
        "activity",
        "other"
      ],
      "title": "BudgetCategory",
      "type": "string"
    },
    "BudgetPlanningContext": {
      "additionalProperties": false,
      "properties": {
        "total_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Total Limit"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        },
        "hard_limit": {
          "title": "Hard Limit",
          "type": "boolean"
        },
        "included_categories": {
          "items": {
            "$ref": "#/$defs/BudgetCategory"
          },
          "minItems": 1,
          "title": "Included Categories",
          "type": "array"
        },
        "excluded_categories": {
          "items": {
            "$ref": "#/$defs/BudgetCategory"
          },
          "title": "Excluded Categories",
          "type": "array"
        },
        "includes_lodging": {
          "title": "Includes Lodging",
          "type": "boolean"
        },
        "reference_party_per_day": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Reference Party Per Day"
        },
        "reference_per_traveler_trip": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Reference Per Traveler Trip"
        },
        "reference_per_traveler_day": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Reference Per Traveler Day"
        }
      },
      "required": [
        "total_limit",
        "hard_limit",
        "included_categories",
        "excluded_categories",
        "includes_lodging",
        "reference_party_per_day",
        "reference_per_traveler_trip",
        "reference_per_traveler_day"
      ],
      "title": "BudgetPlanningContext",
      "type": "object"
    },
    "BudgetQuantityBasis": {
      "enum": [
        "room_night",
        "party_day",
        "traveler_trip",
        "party_trip"
      ],
      "title": "BudgetQuantityBasis",
      "type": "string"
    },
    "CandidatePOI": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "city": {
          "minLength": 1,
          "title": "City",
          "type": "string"
        },
        "district": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "District"
        },
        "address": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "location": {
          "$ref": "#/$defs/GeoPoint"
        },
        "categories": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        },
        "environment": {
          "$ref": "#/$defs/ActivityEnvironment",
          "default": "unknown"
        },
        "suggested_duration_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 720,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Duration Minutes"
        },
        "tags": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        }
      },
      "required": [
        "candidate_id",
        "name",
        "city",
        "location",
        "categories",
        "source"
      ],
      "title": "CandidatePOI",
      "type": "object"
    },
    "CandidateStay": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "city": {
          "minLength": 1,
          "title": "City",
          "type": "string"
        },
        "district": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "District"
        },
        "address": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "location": {
          "$ref": "#/$defs/GeoPoint"
        },
        "area_name": {
          "minLength": 1,
          "title": "Area Name",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "nightly_price_estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "price_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/StayPriceBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "price_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "availability_status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Availability Status",
          "type": "string"
        },
        "booking_supported": {
          "const": false,
          "default": false,
          "title": "Booking Supported",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        }
      },
      "required": [
        "candidate_id",
        "name",
        "city",
        "location",
        "area_name",
        "source"
      ],
      "title": "CandidateStay",
      "type": "object"
    },
    "ClarificationKind": {
      "enum": [
        "unsupported_destination",
        "missing_rooms",
        "missing_budget",
        "unconfirmed_constraint"
      ],
      "title": "ClarificationKind",
      "type": "string"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Constraint Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConstraintKind"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        },
        "strength": {
          "$ref": "#/$defs/ConstraintStrength"
        },
        "priority": {
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/ConstraintSource"
        },
        "applies_to_dates": {
          "default": [],
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Applies To Dates",
          "type": "array"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "constraint_id",
        "kind",
        "value",
        "strength",
        "priority",
        "source",
        "confirmed"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "ConstraintKind": {
      "enum": [
        "must_visit",
        "avoid",
        "interest",
        "walking_intensity",
        "transport_mode",
        "accommodation",
        "meal",
        "accessibility",
        "schedule"
      ],
      "title": "ConstraintKind",
      "type": "string"
    },
    "ConstraintSource": {
      "enum": [
        "user_explicit",
        "user_confirmed",
        "agent_inferred",
        "system"
      ],
      "title": "ConstraintSource",
      "type": "string"
    },
    "ConstraintStrength": {
      "enum": [
        "hard",
        "soft"
      ],
      "title": "ConstraintStrength",
      "type": "string"
    },
    "DataMode": {
      "enum": [
        "live",
        "fixture",
        "user_input",
        "estimate"
      ],
      "title": "DataMode",
      "type": "string"
    },
    "DestinationContext": {
      "additionalProperties": false,
      "properties": {
        "input_name": {
          "minLength": 1,
          "title": "Input Name",
          "type": "string"
        },
        "normalized_name": {
          "minLength": 1,
          "title": "Normalized Name",
          "type": "string"
        },
        "administrative_code": {
          "anyOf": [
            {
              "pattern": "^\\d{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Administrative Code"
        },
        "primary_provider_supported": {
          "title": "Primary Provider Supported",
          "type": "boolean"
        }
      },
      "required": [
        "input_name",
        "normalized_name",
        "primary_provider_supported"
      ],
      "title": "DestinationContext",
      "type": "object"
    },
    "GeoPoint": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "GeoPoint",
      "type": "object"
    },
    "MoneyRange": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Maximum"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "MoneyRange",
      "type": "object"
    },
    "PartyPlanningContext": {
      "additionalProperties": false,
      "properties": {
        "adults": {
          "maximum": 20,
          "minimum": 0,
          "title": "Adults",
          "type": "integer"
        },
        "children": {
          "maximum": 20,
          "minimum": 0,
          "title": "Children",
          "type": "integer"
        },
        "seniors": {
          "maximum": 20,
          "minimum": 0,
          "title": "Seniors",
          "type": "integer"
        },
        "total_travelers": {
          "maximum": 60,
          "minimum": 1,
          "title": "Total Travelers",
          "type": "integer"
        },
        "rooms": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rooms"
        },
        "lodging_nights": {
          "maximum": 4,
          "minimum": 1,
          "title": "Lodging Nights",
          "type": "integer"
        },
        "room_nights": {
          "anyOf": [
            {
              "maximum": 80,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Nights"
        }
      },
      "required": [
        "adults",
        "children",
        "seniors",
        "total_travelers",
        "lodging_nights"
      ],
      "title": "PartyPlanningContext",
      "type": "object"
    },
    "PlannerCapability": {
      "enum": [
        "candidate_search",
        "stay_search",
        "weather_lookup",
        "route_planning",
        "budget_validation",
        "plan_finalization"
      ],
      "title": "PlannerCapability",
      "type": "string"
    },
    "PlannerContext": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "compiler_version": {
          "const": "planner-context-v1",
          "default": "planner-context-v1",
          "title": "Compiler Version",
          "type": "string"
        },
        "context_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Context Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Request Id",
          "type": "string"
        },
        "input_request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Request Sha256",
          "type": "string"
        },
        "locale": {
          "const": "zh-CN",
          "default": "zh-CN",
          "title": "Locale",
          "type": "string"
        },
        "origin_city": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin City"
        },
        "destination": {
          "$ref": "#/$defs/DestinationContext"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "day_count": {
          "maximum": 5,
          "minimum": 2,
          "title": "Day Count",
          "type": "integer"
        },
        "lodging_nights": {
          "maximum": 4,
          "minimum": 1,
          "title": "Lodging Nights",
          "type": "integer"
        },
        "party": {
          "$ref": "#/$defs/PartyPlanningContext"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetPlanningContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "travel_styles": {
