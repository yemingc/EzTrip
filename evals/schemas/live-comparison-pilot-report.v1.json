      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "case_count": {
      "const": 3,
      "default": 3,
      "title": "Case Count",
      "type": "integer"
    },
    "repetitions_per_case": {
      "const": 2,
      "default": 2,
      "title": "Repetitions Per Case",
      "type": "integer"
    },
    "trial_count": {
      "const": 6,
      "default": 6,
      "title": "Trial Count",
      "type": "integer"
    },
    "execution_mode": {
      "$ref": "#/$defs/LiveExecutionMode"
    },
    "live_calls_performed": {
      "title": "Live Calls Performed",
      "type": "boolean"
    },
    "langsmith_tracing_enabled": {
      "title": "Langsmith Tracing Enabled",
