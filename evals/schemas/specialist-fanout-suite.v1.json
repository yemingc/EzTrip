{
  "$defs": {
    "BudgetCategory": {
      "enum": [
        "lodging",
        "transport",
        "food",
        "admission",
        "activity",
        "other"
      ],
      "title": "BudgetCategory",
      "type": "string"
    },
    "BudgetConstraint": {
      "additionalProperties": false,
      "properties": {
        "total_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Total Limit"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        },
        "scope": {
          "const": "party_total",
          "default": "party_total",
          "title": "Scope",
          "type": "string"
        },
        "period": {
          "const": "whole_trip",
          "default": "whole_trip",
          "title": "Period",
          "type": "string"
        },
        "included_categories": {
          "items": {
            "$ref": "#/$defs/BudgetCategory"
          },
          "minItems": 1,
          "title": "Included Categories",
          "type": "array"
        },
        "hard_limit": {
          "default": true,
          "title": "Hard Limit",
          "type": "boolean"
        }
      },
      "required": [
        "total_limit",
        "included_categories"
      ],
      "title": "BudgetConstraint",
      "type": "object"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Constraint Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConstraintKind"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        },
        "strength": {
          "$ref": "#/$defs/ConstraintStrength"
        },
        "priority": {
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/ConstraintSource"
        },
        "applies_to_dates": {
          "default": [],
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Applies To Dates",
          "type": "array"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "constraint_id",
        "kind",
        "value",
        "strength",
        "priority",
        "source",
        "confirmed"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "ConstraintKind": {
      "enum": [
        "must_visit",
        "avoid",
        "interest",
        "walking_intensity",
        "transport_mode",
        "accommodation",
        "meal",
        "accessibility",
        "schedule"
      ],
      "title": "ConstraintKind",
      "type": "string"
    },
    "ConstraintSet": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "title": "ConstraintSet",
      "type": "object"
    },
    "ConstraintSource": {
      "enum": [
        "user_explicit",
        "user_confirmed",
        "agent_inferred",
        "system"
      ],
      "title": "ConstraintSource",
      "type": "string"
    },
    "ConstraintStrength": {
      "enum": [
        "hard",
        "soft"
      ],
      "title": "ConstraintStrength",
      "type": "string"
    },
    "Party": {
      "additionalProperties": false,
      "properties": {
        "adults": {
          "maximum": 20,
          "minimum": 0,
          "title": "Adults",
          "type": "integer"
        },
        "children": {
          "default": 0,
          "maximum": 20,
          "minimum": 0,
          "title": "Children",
          "type": "integer"
        },
        "seniors": {
          "default": 0,
          "maximum": 20,
          "minimum": 0,
          "title": "Seniors",
          "type": "integer"
        },
        "rooms": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rooms"
        }
      },
      "required": [
        "adults"
      ],
      "title": "Party",
      "type": "object"
    },
    "ProviderErrorCategory": {
      "enum": [
        "timeout",
        "rate_limited",
        "empty_result",
        "missing_field",
        "authentication_failed",
        "unrecoverable"
      ],
      "title": "ProviderErrorCategory",
      "type": "string"
    },
    "SpecialistBranchExpectation": {
      "additionalProperties": false,
      "properties": {
        "specialist": {
          "$ref": "#/$defs/SpecialistName"
        },
        "status": {
          "$ref": "#/$defs/SpecialistBranchStatus"
        },
        "provider_failure_category": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderErrorCategory"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "specialist",
        "status"
      ],
      "title": "SpecialistBranchExpectation",
      "type": "object"
    },
    "SpecialistBranchStatus": {
      "enum": [
        "succeeded",
        "skipped",
        "failed"
      ],
      "title": "SpecialistBranchStatus",
      "type": "string"
    },
    "SpecialistFanoutEvalCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Case Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/TripRequest"
        },
        "explore_fixture_case_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Explore Fixture Case Id",
          "type": "string"
        },
        "stay_fixture_case_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Stay Fixture Case Id",
          "type": "string"
        },
        "injected_provider_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpecialistName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected": {
          "$ref": "#/$defs/SpecialistFanoutExpectation"
        },
        "boundary_notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Boundary Notes",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "title",
        "request",
        "explore_fixture_case_id",
        "stay_fixture_case_id",
        "expected",
        "boundary_notes"
      ],
      "title": "SpecialistFanoutEvalCase",
      "type": "object"
    },
    "SpecialistFanoutExpectation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/SpecialistFanoutStatus"
        },
        "branches": {
          "items": {
            "$ref": "#/$defs/SpecialistBranchExpectation"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Branches",
          "type": "array"
        },
        "require_parallel_provider_entry": {
          "default": false,
          "title": "Require Parallel Provider Entry",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "branches"
      ],
      "title": "SpecialistFanoutExpectation",
      "type": "object"
    },
    "SpecialistFanoutStatus": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "failed"
      ],
      "title": "SpecialistFanoutStatus",
      "type": "string"
    },
    "SpecialistName": {
      "enum": [
        "explore",
        "stay",
        "weather"
      ],
      "title": "SpecialistName",
      "type": "string"
    },
    "TripRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Request Id",
          "type": "string"
        },
        "locale": {
          "const": "zh-CN",
          "default": "zh-CN",
          "title": "Locale",
          "type": "string"
        },
        "raw_text": {
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "origin_city": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin City"
        },
        "destination_city": {
          "minLength": 1,
          "title": "Destination City",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "party": {
          "$ref": "#/$defs/Party"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetConstraint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "travel_styles": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Travel Styles",
          "type": "array"
        },
        "constraints": {
          "$ref": "#/$defs/ConstraintSet"
        }
      },
      "required": [
        "request_id",
        "raw_text",
        "destination_city",
        "start_date",
        "end_date",
        "party"
      ],
      "title": "TripRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "suite": {
      "const": "specialist-fanout-v1",
      "default": "specialist-fanout-v1",
      "title": "Suite",
      "type": "string"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "data_mode": {
      "const": "fixture",
      "default": "fixture",
      "title": "Data Mode",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/SpecialistFanoutEvalCase"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "cases"
  ],
  "title": "SpecialistFanoutEvalSuite",
  "type": "object"
}
