{
  "$defs": {
    "ActivityEnvironment": {
      "enum": [
        "indoor",
        "outdoor",
        "mixed",
        "unknown"
      ],
      "title": "ActivityEnvironment",
      "type": "string"
    },
    "BudgetAssessmentStatus": {
      "enum": [
        "not_requested",
        "within_limit",
        "possible_overrun",
        "exceeded",
        "incomplete"
      ],
      "title": "BudgetAssessmentStatus",
      "type": "string"
    },
    "BudgetCategory": {
      "enum": [
        "lodging",
        "transport",
        "food",
        "admission",
        "activity",
        "other"
      ],
      "title": "BudgetCategory",
      "type": "string"
    },
    "BudgetConstraint": {
      "additionalProperties": false,
      "properties": {
        "total_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Total Limit"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        },
        "scope": {
          "const": "party_total",
          "default": "party_total",
          "title": "Scope",
          "type": "string"
        },
        "period": {
          "const": "whole_trip",
          "default": "whole_trip",
          "title": "Period",
          "type": "string"
        },
        "included_categories": {
          "items": {
            "$ref": "#/$defs/BudgetCategory"
          },
          "minItems": 1,
          "title": "Included Categories",
          "type": "array"
        },
        "hard_limit": {
          "default": true,
          "title": "Hard Limit",
          "type": "boolean"
        }
      },
      "required": [
        "total_limit",
        "included_categories"
      ],
      "title": "BudgetConstraint",
      "type": "object"
    },
    "CandidatePOI": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "city": {
          "minLength": 1,
          "title": "City",
          "type": "string"
        },
        "district": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "District"
        },
        "address": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "location": {
          "$ref": "#/$defs/GeoPoint"
        },
        "categories": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        },
        "environment": {
          "$ref": "#/$defs/ActivityEnvironment",
          "default": "unknown"
        },
        "suggested_duration_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 720,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Duration Minutes"
        },
        "tags": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        }
      },
      "required": [
        "candidate_id",
        "name",
        "city",
        "location",
        "categories",
        "source"
      ],
      "title": "CandidatePOI",
      "type": "object"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Constraint Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConstraintKind"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        },
        "strength": {
          "$ref": "#/$defs/ConstraintStrength"
        },
        "priority": {
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/ConstraintSource"
        },
        "applies_to_dates": {
          "default": [],
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Applies To Dates",
          "type": "array"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "constraint_id",
        "kind",
        "value",
        "strength",
        "priority",
        "source",
        "confirmed"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "ConstraintKind": {
      "enum": [
        "must_visit",
        "avoid",
        "interest",
        "walking_intensity",
        "transport_mode",
        "accommodation",
        "meal",
        "accessibility",
        "schedule"
      ],
      "title": "ConstraintKind",
      "type": "string"
    },
    "ConstraintSet": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "title": "ConstraintSet",
      "type": "object"
    },
    "ConstraintSource": {
      "enum": [
        "user_explicit",
        "user_confirmed",
        "agent_inferred",
        "system"
      ],
      "title": "ConstraintSource",
      "type": "string"
    },
    "ConstraintStrength": {
      "enum": [
        "hard",
        "soft"
      ],
      "title": "ConstraintStrength",
      "type": "string"
    },
    "CostItem": {
      "additionalProperties": false,
      "properties": {
        "cost_item_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Cost Item Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/BudgetCategory"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,11}0*$)\\d{0,8}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "unit_price": {
          "$ref": "#/$defs/MoneyRange"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        },
        "is_estimate": {
          "title": "Is Estimate",
          "type": "boolean"
        }
      },
      "required": [
        "cost_item_id",
        "category",
        "description",
        "quantity",
        "unit_price",
        "source",
        "is_estimate"
      ],
      "title": "CostItem",
      "type": "object"
    },
    "DataMode": {
      "enum": [
        "live",
        "fixture",
        "user_input",
        "estimate"
      ],
      "title": "DataMode",
      "type": "string"
    },
    "ExpectedPOISearchCall": {
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "minLength": 1,
          "title": "Keywords",
          "type": "string"
        },
        "city_adcode": {
          "pattern": "^\\d{6}$",
          "title": "City Adcode",
          "type": "string"
        },
        "limit": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "keywords",
        "city_adcode"
      ],
      "title": "ExpectedPOISearchCall",
      "type": "object"
    },
    "GeoPoint": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "GeoPoint",
      "type": "object"
    },
    "MoneyRange": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Maximum"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "MoneyRange",
      "type": "object"
    },
    "Party": {
      "additionalProperties": false,
      "properties": {
        "adults": {
          "maximum": 20,
          "minimum": 0,
          "title": "Adults",
          "type": "integer"
        },
        "children": {
          "default": 0,
          "maximum": 20,
          "minimum": 0,
          "title": "Children",
          "type": "integer"
        },
        "seniors": {
          "default": 0,
          "maximum": 20,
          "minimum": 0,
          "title": "Seniors",
          "type": "integer"
        },
        "rooms": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rooms"
        }
      },
      "required": [
        "adults"
      ],
      "title": "Party",
      "type": "object"
    },
    "PlanValidationStatus": {
      "enum": [
        "passed",
        "warning",
        "conflicted"
      ],
      "title": "PlanValidationStatus",
      "type": "string"
    },
    "PlannerPlacementProposal": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "day_number": {
          "maximum": 5,
          "minimum": 1,
          "title": "Day Number",
          "type": "integer"
        },
        "start_time": {
          "pattern": "^(?:0[8-9]|1\\d|2[0-1]):(?:00|30)$",
          "title": "Start Time",
          "type": "string"
        },
        "reason": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "day_number",
        "start_time",
        "reason"
      ],
      "title": "PlannerPlacementProposal",
      "type": "object"
    },
    "PlannerProposalBatch": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/PlannerPlacementProposal"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "PlannerProposalBatch",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "Traceable origin for provider data or an explicit estimate.",
      "properties": {
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "data_mode": {
          "$ref": "#/$defs/DataMode"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "raw_response_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Response Sha256"
        }
      },
      "required": [
        "provider",
        "data_mode",
        "retrieved_at"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "TripRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Request Id",
          "type": "string"
        },
        "locale": {
          "const": "zh-CN",
          "default": "zh-CN",
          "title": "Locale",
          "type": "string"
        },
        "raw_text": {
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "origin_city": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin City"
        },
        "destination_city": {
          "minLength": 1,
          "title": "Destination City",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "party": {
          "$ref": "#/$defs/Party"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetConstraint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "travel_styles": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Travel Styles",
          "type": "array"
        },
        "constraints": {
          "$ref": "#/$defs/ConstraintSet"
        }
      },
      "required": [
        "request_id",
        "raw_text",
        "destination_city",
        "start_date",
        "end_date",
        "party"
      ],
      "title": "TripRequest",
      "type": "object"
    },
    "VerticalSliceCase": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "case_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Case Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/TripRequest"
        },
        "provider_responses": {
          "items": {
            "$ref": "#/$defs/VerticalSlicePOIResponse"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Provider Responses",
          "type": "array"
        },
        "planner_proposal": {
          "$ref": "#/$defs/PlannerProposalBatch"
        },
        "planner_model": {
          "const": "fixture-planner-gate2-v1",
          "default": "fixture-planner-gate2-v1",
          "title": "Planner Model",
          "type": "string"
        },
        "cost_items": {
          "items": {
            "$ref": "#/$defs/CostItem"
          },
          "minItems": 1,
          "title": "Cost Items",
          "type": "array"
        },
        "expected": {
          "$ref": "#/$defs/VerticalSliceExpected"
        },
        "boundary_notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Boundary Notes",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "title",
        "request",
        "provider_responses",
        "planner_proposal",
        "cost_items",
        "expected",
        "boundary_notes"
      ],
      "title": "VerticalSliceCase",
      "type": "object"
    },
    "VerticalSliceExpected": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "$ref": "#/$defs/VerticalSliceOutcome"
        },
        "validation_status": {
          "$ref": "#/$defs/PlanValidationStatus"
        },
        "budget_status": {
          "$ref": "#/$defs/BudgetAssessmentStatus"
        },
        "can_finalize": {
          "title": "Can Finalize",
          "type": "boolean"
        },
        "issue_rule_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Issue Rule Codes",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "validation_status",
        "budget_status",
        "can_finalize"
      ],
      "title": "VerticalSliceExpected",
      "type": "object"
    },
    "VerticalSliceOutcome": {
      "enum": [
        "ready",
        "conflicted"
      ],
      "title": "VerticalSliceOutcome",
      "type": "string"
    },
    "VerticalSlicePOIResponse": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/ExpectedPOISearchCall"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidatePOI"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "request",
        "candidates"
      ],
      "title": "VerticalSlicePOIResponse",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "suite": {
      "const": "beijing-three-day-vertical-slice-gate2-v1",
      "default": "beijing-three-day-vertical-slice-gate2-v1",
      "title": "Suite",
      "type": "string"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "execution_mode": {
      "const": "fixture",
      "default": "fixture",
      "title": "Execution Mode",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/VerticalSliceCase"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "cases"
  ],
  "title": "VerticalSliceSuite",
  "type": "object"
}
